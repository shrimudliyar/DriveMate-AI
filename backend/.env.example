# DriveMate AI - Backend Environment Configuration Template
# Copy this file to backend/.env for local development, or add these variables to Render Dashboard.
# NEVER commit your actual .env file or credentials to source control.

# Supabase Project Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role secret key for backend server execution ONLY.
# NEVER expose this key to the frontend or browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Supabase JWT Secret for cryptographic token decoding (from Supabase Dashboard -> Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
ENABLE_DEMO_AUTH=false

# CORS Configuration for Frontend Access
# Comma-separated list of allowed explicit origins
CORS_ORIGINS=https://drivemate-ai.vercel.app,http://localhost:5173
# Optional regex to match Vercel preview deployments
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Gnani AI Voice Assistant Settings (Phase 3: Speech-to-Text & Text-to-Speech)
# Generate your API key from the Gnani AI dashboard (https://docs.gnani.ai/api/introduction/introduction)
# Pass through header X-API-Key-ID: <GNANI_API_KEY> on the backend only.
GNANI_API_KEY=your-gnani-api-key-here
GNANI_BASE_URL=https://api.vachana.ai
GNANI_STT_MODEL=gnani-prisma-v2.5
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_LANGUAGE_CODE=en-IN

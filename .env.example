# DriveMate AI — Frontend Environment Variables (Browser-Safe Only)
# Used by Vite during build/runtime. Configured in Vercel project settings for production.
# NEVER put service-role secret keys or backend private credentials here.

# Supabase Public API (Required for authentication & database queries)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend API URL:
# For local development with Vite proxy: /api
# For Vercel production deployment: https://your-backend-service.onrender.com
VITE_API_URL=/api
